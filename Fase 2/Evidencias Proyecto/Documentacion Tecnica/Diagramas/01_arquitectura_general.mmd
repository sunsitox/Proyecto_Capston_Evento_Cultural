  classDef hostc fill:#FFFFFF,stroke:#9A9A9A,color:#444444

  SRC["Fuentes públicas chilenas<br/>(22 agendas: 21 permanentes + 1 estacional)"]
  GHA["GitHub Actions<br/>workflow scrape-events.yml<br/>cron diario 23:37 (America/Santiago)"]
  NIM["NVIDIA NIM<br/>(40 RPM globales)"]
  USR["Visitante / Usuario registrado / Organizador<br/>(web y móvil)"]
  HOST["Vercel<br/>(hosting previsto, sin evidencia de despliegue)"]

  subgraph G1["Scraper (Python)"]
    PIPE["<b>pipeline.py</b><br/>Orquestación por fases"]
    CONN["<b>connectors/</b><br/>Strategy por familia de fuentes"]
    NVD["<b>services/nvidia.py</b><br/>OCR · ubicación · redacción"]
    ST["<b>state.py — checkpoints</b><br/>SQLite (reanudable)"]
    EXP["<b>exporters.py</b><br/>JSON / CSV por región"]
    SAN["Sanitización · filtro cultural<br/>deduplicación · ubicación"]
  end

  subgraph G2["Supabase — PostgreSQL + RLS"]
    B1["events · categories<br/>event_categories · media_assets"]
    B2["sources · organizers<br/>communes · scrape_runs"]
    B3["event_provenance<br/>(evidencia privada)"]
    B4["profiles · user_event_interactions · reports<br/>(app · RLS)"]
  end

  subgraph G4["API intermedia (Python, supabase_backend.py)"]
    API["<b>HTTP · librería estándar</b><br/>GET /api/eventos (PostgREST)"]
    AUTH["<b>Auth proxy</b><br/>POST /api/auth/login · registro<br/>OAuth /api/auth/oauth + callback<br/>DELETE /api/auth/cuenta (Admin API)"]
  end

  subgraph G3["Frontend — Angular 22 + Ionic 9"]
    F1["Pages: home · mapa (Leaflet/OSM) · calendario<br/>para-ti · detalle · publicar · login · perfil"]
    F2["core/services (signals):<br/>EventosService · ApiService · Recomendaciones"]
    F3["Navegación adaptativa<br/>(tab bar móvil / nav escritorio)"]
    F4["data/mock-eventos.ts<br/>(respaldo si la API no responde)"]
  end

  SRC -->|"HTTP · Playwright"| G1
  GHA -->|ejecuta| G1
  NIM -->|"IA selectiva"| G1
  PIPE -->|"fuentes validadas"| CONN
  CONN -->|"Event normalizado"| SAN
  SAN -->|"respaldo local"| EXP
  PIPE -->|"solo nuevos/modificados"| NVD
  PIPE -->|checkpoint| ST
  G1 -->|"upsert idempotente"| G2
  F2 -->|"HttpClient<br/>GET catálogo · login · OAuth"| G4
  API -->|"PostgREST (clave pública)"| G2
  AUTH -->|"GoTrue + Admin API"| G2
  G4 -.->|"INSERT con clave pública<br/>bloqueado por RLS (501)"| G2
  F1 --> F2
  F2 -.->|"respaldo demo"| F4
  USR -->|consulta| G3
  USR -.->|"OAuth Google (consentimiento)<br/>regreso /auth/callback"| AUTH
  G3 -.->|"despliegue previsto"| HOST

