# =============================================================================
# Evento Cultural - Plantilla de Variables de Entorno (.env.example)
# =============================================================================
# Copia este archivo como .env para desarrollo local o como referencia de secretos.
# IMPORTANTE: Nunca subas el archivo .env con valores reales a repositorios públicos.
# =============================================================================

# URL base del proyecto Supabase (PostgreSQL + PostgREST + GoTrue)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública 'anon' (Publishable API Key).
# Es segura para el navegador ya que el acceso a datos se rige por Row Level Security (RLS).
SUPABASE_PUBLIC_KEY=sb_publishable_tu_clave_publica_aqui

# Origen permitido para CORS y redirecciones OAuth (ej: http://localhost:4200 o https://tu-dominio.vercel.app)
FRONTEND_ORIGIN=http://localhost:4200

# Clave secreta administrativa (Service Role Key).
# ADVERTENCIA: Esta clave NUNCA debe incluirse en el frontend ni en repositorios.
# Se utiliza exclusivamente en la Edge Function 'admin-account' (como secreto en Supabase Secrets)
# para operaciones con privilegios elevados (ej. eliminación de cuentas).
SUPABASE_SECRET_KEY=tu_service_role_key_privada_aqui
